{
  "name": "mission-control",
  "productName": "Mission Control",
  "version": "1.0.0",
  "description": "A desktop desk for options traders: run your own signal scanner, chart the results in your signed-in TradingView, and model trades in an options profit/loss calculator.",
  "main": "./out/main/index.js",
  "author": "Mission Control contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "node scripts/guard-running.mjs && npm run build && electron-builder --win",
    "build:dir": "node scripts/guard-running.mjs && npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@electron-toolkit/utils": "4.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "yahoo-finance2": "4.0.3"
  }
}
